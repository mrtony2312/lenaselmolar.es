APP_NAME="Leñas El Molar C.B."
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lenaselmolar.es

APP_LOCALE=es_ES
APP_FALLBACK_LOCALE=es_ES
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
# Si tu préfères MySQL (fourni par Hostinger dans hPanel > Bases de données) :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=""   # entre comillas si contiene # $ o espacios
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Datos bancarios para el pago por transferencia (rellenar con los datos reales de Leñas El Molar C.B.)
BANK_HOLDER="Leñas El Molar C.B."
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# Google Merchant Center (feed + JSON-LD + políticas)
MERCHANT_FEED_TOKEN=
MERCHANT_CURRENCY=EUR
MERCHANT_TARGET_COUNTRY=ES
MERCHANT_DEFAULT_BRAND=
# Envío: fuente única para ficha, carrito, checkout, páginas legales, JSON-LD y flux.
# Solo se publica (y se añade al total) cuando AMBOS flags son true y los valores son reales.
MERCHANT_SHIPPING_PUBLISH=false
MERCHANT_SHIPPING_COVERAGE_CONFIRMED=false
MERCHANT_SHIPPING_PUBLISH_TRANSIT=false
MERCHANT_SHIPPING_PRICE=
MERCHANT_HANDLING_MIN_DAYS=
MERCHANT_HANDLING_MAX_DAYS=
MERCHANT_TRANSIT_MIN_DAYS=
MERCHANT_TRANSIT_MAX_DAYS=
MERCHANT_RETURN_DAYS=14

# Perfiles sociales reales de la empresa (vacío = sin icono)
MERCHANT_FACEBOOK_URL=
MERCHANT_INSTAGRAM_URL=

MERCHANT_REFERENCE_PRICES_VERIFIED=false
